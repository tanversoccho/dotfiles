{
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "height": 40,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "margin-bottom": 0,
  "spacing": 6,
  "reload_style_on_change": true,

  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "network",
    "tray",
    // "cpu",
    // "memory",
    // "disk",
    "pulseaudio",
    "custom/system-info",
    "clock"
  ],

  "hyprland/window": {
    "format": "{title}",
    "icon": false,
    "max-length": 80,
    "separate-outputs": true,
    "tooltip": false
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "tooltip": false,
    "all-outputs": false,
    "sort-by-number": true,
    "disable-scroll": false,
    "on-scroll-up": "hyprctl dispatch workspace +1",
    "on-scroll-down": "hyprctl dispatch workspace -1",
    "active-only": false,
    "show-special": false
  },

  "tray": {
    "format": "{icon}",
    "tooltip": true,
    "icon-size": 18,
    "spacing": 0
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "tooltip": true,
    "tooltip-format": "{desc} — {volume}%",
    "format-icons": {
      "headphone": "󰋋",
      "default": ["", "", ""]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol"
  },

  "network": {
    "format": "{icon} {essid}",
    "format-icons": {
      "ethernet": "󰈀",
      "wifi": "󰖩",
      "disconnected": "󰖪"
    },
    "tooltip": true,
    "tooltip-format": "{ifname} via {gwaddr}",
    "interval": 5
  },

  "cpu": {
    "format": "󰻠 {usage}%",
    "interval": 2,
    "tooltip": false
  },

  "memory": {
    "format": "󰍛",
    "tooltip": true,
    "tooltip-format": "RAM: Used {used:0.1f}G / Total {total:0.1f}G",
    "interval": 4
  },

  "disk": {
    "interval": 30,
    "unit": "GB",
    "format": "󰋊",
    "path": "/",
    "tooltip": true,
    "tooltip-format": "Root: Used {specific_used:0.2f}G / Free {specific_free:0.2f}G"
  },

  "custom/system-info": {
    "exec": "~/.config/waybar/scripts/sysinfo.sh",
    "return-type": "json",
    "interval": 5,
    "tooltip": true,
    "format": "{}"
  },

  "clock": {
    "format": "{:%a %d %b  %I:%M %p}",
    "format-alt": "{:%A, %B %d, %Y  %I:%M:%S %p}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "first-day-of-week": 1,
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months":   "<span color='#ffead3'><b>{}</b></span>",
        "days":     "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks":    "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today":    "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    }
  }
}
