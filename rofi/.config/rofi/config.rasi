configuration {
modi: ["drun", "window", "run"];
      icon-theme: "Papirus-Dark";
      show-icons: true;
terminal: "kitty";
          drun-display-format: "{icon} {name}";
location: 0;
          disable-history: false;
          sidebar-mode: false;
font: "JetBrainsMono Nerd Font 11";

      kb-row-left:  "Control+h,Left";
      kb-row-down:  "Control+j,Down";
      kb-row-up:    "Control+k,Up";
      kb-row-right: "Control+l,Right";
      kb-accept-entry: "Control+z,Control+y,Return,KP_Enter";

      kb-remove-to-eol:     "";
      kb-move-char-back:    "Control+b";
      kb-remove-char-back:  "BackSpace";
      kb-move-char-forward: "Control+f";
      kb-mode-complete:     "Control+o";
}

* {
  background-color: #1e1e2e;
  text-color:       #cdd6f4;
font:             "JetBrainsMono Nerd Font 11";
}

window {
width:            45%;
padding:          20px;
                  border-radius:    12px;
                  border-width:     1px;
                  border-color:     #313244;
                  background-color: #1e1e2e;
                  text-color:       #cdd6f4;
}

mainbox {
children:         [ inputbar, listview ];
spacing:          14px;
padding:          0px;
                  background-color: #1e1e2e;
                  text-color:       #cdd6f4;
}

inputbar {
children:         [ prompt, entry ];
                  background-color: #181825;
                  border-radius:    10px;
padding:          10px 14px;
spacing:          10px;
                  border-width:     1px;
                  border-color:     #313244;
                  text-color:       #cdd6f4;
}

prompt {
  background-color: transparent;
  text-color:       #89b4fa;
padding:          0px;
font:             "JetBrainsMono Nerd Font Bold 11";
}

entry {
placeholder:       "Search…";
                   placeholder-color: #6c7086;
                   background-color:  transparent;
                   text-color:        #cdd6f4;
expand:            true;
padding:           0px;
}

listview {
columns:          3;
lines:            4;
cycle:            false;
dynamic:          true;
layout:           vertical;
spacing:          8px;
scrollbar:        false;
                  background-color: transparent;
                  text-color:       #cdd6f4;
}

element {
orientation:      vertical;
padding:          10px 6px;
spacing:          4px;
                  border-radius:    10px;
                  background-color: transparent;
cursor:           pointer;
                  text-color:       #a6adc8;
}

element normal.normal {
  background-color: transparent;
}

element normal.urgent {
  background-color: transparent;
}

element alternate.normal {
  background-color: transparent;
}

element alternate.urgent {
  background-color: transparent;
}

element selected.normal {
  background-color: #45475a;
  border-radius:    10px;
}

element selected.urgent {
  background-color: #f38ba8;
  border-radius:    10px;
}

element-icon {
size:             42px;
                  horizontal-align: 0.5;
                  background-color: transparent;
                  text-color:       #cdd6f4;
}

element-text {
expand:           true;
                  horizontal-align: 0.5;
                  vertical-align:   0.5;
                  background-color: transparent;
                  text-color:       #a6adc8;
font:             "JetBrainsMono Nerd Font 10";
}

element selected element-text {
  text-color: #b4befe;
}

element selected element-icon {
  background-color: transparent;
}

scrollbar {
  handle-width:     6px;
  handle-color:     #cba6f7;
  background-color: transparent;
}
